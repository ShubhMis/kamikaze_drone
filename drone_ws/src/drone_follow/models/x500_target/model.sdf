<?xml version="1.0"?>
<sdf version="1.9">
  <model name="x500_target">
    <include merge="true"><uri>model://x500</uri></include>
    <link name="red_marker_link">
      <pose relative_to="base_link">0 0 0.40 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
      <visual name="red_marker">
        <geometry><sphere><radius>0.30</radius></sphere></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>0.7 0 0 1</emissive></material>
      </visual>
    </link>
    <joint name="red_marker_joint" type="fixed"><parent>base_link</parent><child>red_marker_link</child></joint>
  </model>
</sdf>
